{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/problem/layout,_N_T_/problem/page,_N_T_/problem"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/problem/__PAGE__",
    "/problem",
    "/_index",
    "/_head"
  ]
}